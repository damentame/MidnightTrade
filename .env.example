APP_ENV=dev
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/botdb
LOG_LEVEL=INFO

CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost:8000/api/ctrader/callback
CTRADER_ENV=demo
CTRADER_ACCOUNT_ID=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_API_HOST=
SYMBOL=XAUUSD

TRADING_ENABLED=true
RISK_PCT_DEFAULT=0.10
MAX_CONCURRENT_POSITIONS=1
SIGNAL_TTL_MINUTES=180
SWING_L=2
TREND_N=2
SWEEP_SWING_LOOKBACK=3
SWEEP_MAX_AGE_CANDLES=50
FVG_MUST_BE_AFTER_SWEEP=true
ALLOW_LATE_ENTRY=false

SL_BUFFER_POINTS=10
MIN_SL_DISTANCE_POINTS=50
MAX_SPREAD_POINTS=50
PINBAR_WICK_RATIO=2.0
PINBAR_BODY_RATIO=0.4
STRONG_CLOSE_ZONE_PCT=0.2
